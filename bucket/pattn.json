        }
    },
    "shortcuts": [
        [
            "PattN.exe",
            "PattN"
        ]
    ],
    "post_install": [
        "Copy-Item \"$dir\\bin\\*.dat\" \"$dir\\bin\\xray\\\" -ErrorAction SilentlyContinue",
        "Copy-Item \"$dir\\bin\\*.dat\" \"$dir\\bin\\sing_box\\\" -ErrorAction SilentlyContinue",
        "Copy-Item \"$dir\\bin\\*.mmdb\" \"$dir\\bin\\xray\\\" -ErrorAction SilentlyContinue",
        "Copy-Item \"$dir\\bin\\*.mmdb\" \"$dir\\bin\\sing_box\\\" -ErrorAction SilentlyContinue",
        "Copy-Item \"$dir\\bin\\*.dat\" \"$dir\\bin\\mihomo\\\" -ErrorAction SilentlyContinue",
        "Copy-Item \"$dir\\bin\\*.mmdb\" \"$dir\\bin\\mihomo\\\" -ErrorAction SilentlyContinue"
    ],
    "persist": "guiConfigs",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/patterniha/PattN/releases/download/$version/PattN-windows-64-desktop.zip"
            },
